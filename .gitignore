# Python code files - Selectively track core code
# Allow src/ code but ignore cache
!src/**/*.py
*.pyc

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter Notebook - Keep key analysis notebooks
.ipynb_checkpoints
# Allow important notebooks (add specific ones manually)
!notebooks/EDA_3.*.ipynb
!notebooks/correlation_analysis_sagemaker.py

# Virtual Environment
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Documentation folder - Keep project documentation
doc/
docs/
# Allow project structure
!PROJECT_STRUCTURE.md

# Outputs folder - Ignore all outputs except final results
outputs/clustering/*
!outputs/clustering/profiling/
outputs/clustering/profiling/*
!outputs/clustering/profiling/final_20260221_222939/
outputs/classification/
outputs/exploration/
outputs/report/

# Data folder - KEEP ALL FILES IN data/
# (Remove CSV exclusion to allow data upload)

# Model files (if large)
models/*.pkl
models/*.h5
models/*.joblib

# Logs
logs/*.log
*.log

# Temporary files
*.tmp
*.temp

# Word documents (binary, not suitable for version control)
*.docx
*.doc

# Root level CSV files (generated reports)
/*.csv
